# ========================================================
# Legal Metrology AI Service Configuration
# ========================================================

# Option A: Hugging Face Inference API (huggingface_hub InferenceClient)
# Get your free token at: https://huggingface.co/settings/tokens
# Accept Llama 3.1 terms at: https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
HF_TOKEN=hf_your_token_here
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_PROVIDER=huggingface

# Option B: Alternative OpenAI-compatible Providers (e.g. Groq, OpenAI)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.1-8b-instant
# LLM_PROVIDER=openai_compatible

# OCR Engine Configuration
OCR_LANG=eng
